rules_version = '2';

// 角色由 users collection 決定（白名單制，不綁公司網域）。
// doc id = 小寫 email。只有列在 users 裡、且 active != false 的帳號能存取任何資料。
service cloud.firestore {
  match /databases/{database}/documents {

    // ── 基礎工具函式 ──────────────────────────────────────────────
    function signedIn() { return request.auth != null; }

    // 防禦性處理：某些登入方式（自訂 token 等）可能沒有 email claim，
    // 直接對 null 呼叫 .lower() 會讓整條規則式求值出錯；改用 get() 給預設值。
    function email() { return request.auth.token.get('email', '').lower(); }

    // 白名單 + 帳號啟用中，才算「whitelisted」。
    // exists() 先擋掉「使用者文件不存在」（含已被刪除的情況），
    // 再檢查 active 欄位（未設定視為啟用，維持既有資料相容）。
    function whitelisted() {
      return signedIn() && email() != ''
        && exists(/databases/$(database)/documents/users/$(email()))
        && get(/databases/$(database)/documents/users/$(email())).data.get('active', true) != false;
    }
    function udoc() { return get(/databases/$(database)/documents/users/$(email())); }
    function role() { return udoc().data.role; }
    function myRegions() { return udoc().data.get('regions', []); }
    function isManager() { return whitelisted() && role() == 'manager'; }

    function changedOnly(keys) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(keys);
    }

    // ── requests 狀態機 ──────────────────────────────────────────
    function isValidStatus(s) {
      return s in ['pending', 'rejected', 'assigned', 'in_progress', 'reviewing', 'completed'];
    }

    // manager 核准：pending → assigned
    // ccPlanners 是選填欄位(核准時可另外勾選要 CC 通知的 planner，寄信邏輯見 functions/index.js
    // notifyOnAssign)，用 .get(key, []) 才不會因為舊資料/沒勾選而擋掉整個核准動作
    function isApproveTransition() {
      return resource.data.status == 'pending'
        && request.resource.data.status == 'assigned'
        && changedOnly(['status', 'assignedDesigners', 'assignedDesignersNames', 'reviewedBy', 'reviewedAt', 'reviewNote', 'comment', 'dueDate', 'ccPlanners'])
        && request.resource.data.assignedDesigners is list
        && request.resource.data.assignedDesigners.size() > 0
        && isValidCcPlanners(request.resource.data.get('ccPlanners', []))
        && request.resource.data.reviewedBy == email()
        && request.resource.data.reviewedAt == request.time;
    }

    // manager 駁回：pending → rejected
    function isRejectTransition() {
      return resource.data.status == 'pending'
        && request.resource.data.status == 'rejected'
        && changedOnly(['status', 'reviewedBy', 'reviewedAt', 'rejectReason'])
        && request.resource.data.rejectReason is string
        && request.resource.data.rejectReason.size() > 0
        && request.resource.data.reviewedBy == email();
    }

    // manager 事後編輯已審核需求的指派/交期/備註（不可改變 status）
    function isManagerMetaEdit() {
      return resource.data.status == request.resource.data.status
        && resource.data.status in ['assigned', 'in_progress', 'reviewing', 'completed']
        && changedOnly(['assignedDesigners', 'assignedDesignersNames', 'dueDate', 'comment', 'reviewNote', 'ccPlanners'])
        && request.resource.data.assignedDesigners is list
        && isValidCcPlanners(request.resource.data.get('ccPlanners', []));
    }

    // manager 在需求總表把需求標記/取消標記為重要（星號）：不限狀態，只能單獨改這一個欄位，
    // 不影響狀態機或其他審核相關欄位
    function isImportantToggle() {
      return changedOnly(['important'])
        && request.resource.data.important is bool;
    }

    // 設計師：只能依序單步推進，不可跳階、倒退，且時間戳須對應正確欄位
    function isDesignerTransition() {
      return (resource.data.status == 'assigned' && request.resource.data.status == 'in_progress'
              && changedOnly(['status', 'startedAt']) && request.resource.data.startedAt == request.time)
          || (resource.data.status == 'in_progress' && request.resource.data.status == 'reviewing'
              && changedOnly(['status', 'reviewingAt']) && request.resource.data.reviewingAt == request.time)
          || (resource.data.status == 'reviewing' && request.resource.data.status == 'completed'
              && changedOnly(['status', 'completedAt']) && request.resource.data.completedAt == request.time);
    }

    // 附件結構驗證：name/url/size 型別正確、size 落在合理範圍(對應前端 MAX_ATTACHMENT_MB=10)，
    // storagePath(選填)若存在必須精確對應這個 requestId(attachments/{requestId}/{檔名))。
    //
    // 效能設計筆記 —— 這裡曾經因為疊加成本撞到 Firestore「單次請求最多 1000 個運算式」的上限，
    // 導致合法的 10 筆附件寫入被拒，來回試了很多版本才逼近可行解，記錄下來避免後人重踩：
    // 1) d.keys().hasOnly([...]) 極貴：無論用在單一附件(4 個允許欄位)或最外層需求文件(11 個
    //    允許欄位)，只要呼叫就大量吃掉預算，換成 keys().size() 比對(見 isValidRequestCreate 用
    //    d.keys().size() == 11)可以完全等價地判斷「不多不少剛好這些欄位」，但便宜很多。
    // 2) 用 let 綁定 + 三元運算子(cond ? a : b)算「可能用不到」的值(例如「有 storagePath 才 split」)
    //    一樣很貴 —— 即使實際執行時走的是短路的那一支，這個「let + 三元」結構本身的存在就會被
    //    計入預算，不是只算「實際跑到的路徑」。改成把運算直接內嵌在用 && / || 短路的表達式裡
    //    (而不是先算好存進 let)才真的便宜。
    // 3) 因為 1000-expression 預算真的很緊，在「10 筆附件都驗證 storagePath↔requestId 綁定」
    //    這個前提下，沒有多餘預算再驗證「附件物件是否夾帶允許清單以外的額外欄位」(a.keys() 呼叫
    //    本身就會超支)。這裡刻意犧牲這項檢查 —— 額外欄位不是安全漏洞(前端/Cloud Function 只會讀
    //    name/url/size/storagePath 這幾個已知欄位，不會信任或執行任何未知欄位)，只是資料整潔度
    //    考量，兩者衝突時選擇保留安全性更高的 storagePath↔requestId 綁定。
    function isValidAttachment(a, requestId) {
      return a.name is string && a.name.size() > 0 && a.name.size() <= 300
        && a.url is string && a.url.size() > 0 && a.url.size() <= 2000
        && a.size is number && a.size > 0 && a.size <= 10485760
        && (!('storagePath' in a) || (
             a.storagePath is string
             && a.storagePath.split('/').size() == 3
             && a.storagePath.split('/')[0] == 'attachments'
             && a.storagePath.split('/')[1] == requestId
           ));
    }
    // Firestore 規則語言不支援對 list 做逐一元素的迴圈驗證，只能在已知上限(10 筆)內逐一 index 檢查
    function isValidAttachments(atts, requestId) {
      return atts is list && atts.size() <= 10
        && (atts.size() < 1  || isValidAttachment(atts[0], requestId))
        && (atts.size() < 2  || isValidAttachment(atts[1], requestId))
        && (atts.size() < 3  || isValidAttachment(atts[2], requestId))
        && (atts.size() < 4  || isValidAttachment(atts[3], requestId))
        && (atts.size() < 5  || isValidAttachment(atts[4], requestId))
        && (atts.size() < 6  || isValidAttachment(atts[5], requestId))
        && (atts.size() < 7  || isValidAttachment(atts[6], requestId))
        && (atts.size() < 8  || isValidAttachment(atts[7], requestId))
        && (atts.size() < 9  || isValidAttachment(atts[8], requestId))
        && (atts.size() < 10 || isValidAttachment(atts[9], requestId));
    }

    // ccPlanners(核准/事後編輯時可另外勾選 CC 的 planner 清單)：這裡只驗證型別、上限(10 筆)、
    // 每筆是非空字串 —— 控制在 expression 預算內。是否真的對應「存在、角色是 planner、啟用中」的帳號，
    // 需要對每個 email 各查一次 users 文件(get())，疊加在這條 update 規則本來就會多次呼叫
    // whitelisted()/myRegions() 之上，容易逼近單次請求的 get() 呼叫數上限，因此把「身分/角色/
    // 啟用狀態」這層最終驗證留給 Cloud Function(functions/index.js resolveActivePlannerCcEmails)，
    // 那裡才是真正決定「誰會收到通知信」的地方。
    function isValidCcPlanners(v) {
      return v is list && v.size() <= 10
        && (v.size() < 1  || (v[0] is string && v[0].size() > 0))
        && (v.size() < 2  || (v[1] is string && v[1].size() > 0))
        && (v.size() < 3  || (v[2] is string && v[2].size() > 0))
        && (v.size() < 4  || (v[3] is string && v[3].size() > 0))
        && (v.size() < 5  || (v[4] is string && v[4].size() > 0))
        && (v.size() < 6  || (v[5] is string && v[5].size() > 0))
        && (v.size() < 7  || (v[6] is string && v[6].size() > 0))
        && (v.size() < 8  || (v[7] is string && v[7].size() > 0))
        && (v.size() < 9  || (v[8] is string && v[8].size() > 0))
        && (v.size() < 10 || (v[9] is string && v[9].size() > 0));
    }

    // 建立需求時的必要欄位／型別／允許欄位驗證。
    // 這 11 個欄位全部是前端 RequestNewPage 一定會送的必填欄位(沒有選填的)，用「剛好 11 個 key」
    // 取代 d.keys().hasOnly([...11 個 key...])：hasOnly() 要拿允許清單跟這個 map 實際的 key 集合
    // 做全比對，成本會隨清單長度增加，疊加在附件驗證(10 筆逐一檢查)的預算上，是這條規則超過
    // Firestore「單次請求最多 1000 個運算式」上限的主因之一(耗用大量budget，逼近上限)。
    // d.keys().size() == 11 搭配下面逐一驗證這 11 個欄位(全部用直接欄位存取，缺任何一個都會
    // 求值出錯而正確擋下)，效果完全等價，但成本只是「取一次 key 數量」。
    function isValidRequestCreate(requestId) {
      let d = request.resource.data;
      return d.keys().size() == 11
        && d.projectName is string && d.projectName.size() > 0 && d.projectName.size() <= 200
        && d.region is string && d.region.size() > 0
        && d.docTypes is list
        && d.dueDate is string
        && d.description is string
        && d.urgent is bool
        && isValidAttachments(d.attachments, requestId)
        && d.submittedBy == email()
        && d.submittedByName is string
        && d.status == 'pending'
        && d.createdAt == request.time;
    }

    // 使用者名單：自己可讀自己那筆（登入時查角色用）；主管可讀寫全部
    match /users/{uid} {
      allow read: if signedIn() && (uid == email() || isManager());
      allow write: if isManager();
    }

    // 客製化設計需求
    match /requests/{id} {
      allow read: if isManager()
        || (whitelisted() && resource.data.submittedBy == email())                       // planner 看自己送的
        || (whitelisted() && email() in resource.data.get('assignedDesigners', []))      // designer 看指派給自己的
        || (whitelisted() && resource.data.region in myRegions());                       // planner 看負責區域的

      allow create: if whitelisted() && isValidRequestCreate(id);

      allow update: if
          // manager：核准 / 駁回 / 事後編輯 / 標記重要，且 status 必須落在既定 enum 內
          (isManager() && isValidStatus(request.resource.data.status)
            && (isApproveTransition() || isRejectTransition() || isManagerMetaEdit() || isImportantToggle()))
          // 設計師：改自己被指派任務的狀態，只能依合法流程單步推進
          || (whitelisted() && email() in resource.data.get('assignedDesigners', []) && isDesignerTransition())
          // planner：只能把「負責區域」且「非 pending/rejected」的需求改成 completed
          || (whitelisted()
              && resource.data.region in myRegions()
              && resource.data.status in ['assigned', 'in_progress', 'reviewing']
              && request.resource.data.status == 'completed'
              && changedOnly(['status', 'completedAt'])
              && request.resource.data.completedAt == request.time)
          // 提交人：需求仍在待審核時可編輯內容（不可改狀態/提交人），並驗證型別
          || (whitelisted()
              && resource.data.submittedBy == email()
              && resource.data.status == 'pending'
              && request.resource.data.status == 'pending'
              && changedOnly(['urgent', 'region', 'projectName', 'docTypes', 'dueDate', 'description', 'attachments'])
              && request.resource.data.projectName is string && request.resource.data.projectName.size() > 0
              && request.resource.data.region is string && request.resource.data.region.size() > 0
              && request.resource.data.get('docTypes', []) is list
              && isValidAttachments(request.resource.data.get('attachments', []), id));

      // manager 可刪任何需求；提交人只能刪自己「剛建立、還沒有任何附件」的 pending 需求 ——
      // 這只是給 RequestNewPage 建立需求失敗時的回滾用(見該檔案 handleSubmit 的錯誤處理):
      // addDoc 先建立 attachments:[] 的需求文件，若後續上傳/寫入附件失敗就要能刪掉這個半成品，
      // 不然使用者重試會產生重複的空需求。attachments.size()==0 這個條件精確對應「回滾當下」
      // 這個文件唯一可能的狀態(還沒成功寫過任何附件)，同時擋掉刪除「已經有附件、已審核、
      // 或別人送出」的需求 —— 這些情況一律只有 manager 能刪。
      allow delete: if isManager()
        || (whitelisted()
            && resource.data.submittedBy == email()
            && resource.data.status == 'pending'
            && resource.data.attachments.size() == 0);
    }

    // 既有 team-scheduler 資料：讀取開放白名單，寫入收斂為僅 manager
    // （前端本來就以 isManager 隱藏這些頁面的新增/編輯/刪除按鈕，這裡讓後端規則與前端一致，
    //   不再讓「隱藏按鈕」變成唯一防線）
    match /projects/{id}     { allow read: if whitelisted(); allow write: if isManager(); }
    match /people/{id}       { allow read: if whitelisted(); allow write: if isManager(); }
    match /leaves/{id}       { allow read: if whitelisted(); allow write: if isManager(); }

    // settings/permissions 只有 manager 能寫；其餘 settings（里程碑規則、設計類別）也收斂為 manager 可寫
    match /settings/{id} {
      allow read: if whitelisted();
      allow write: if isManager();
    }

    match /hblPayments/{id}  { allow read: if whitelisted(); allow write: if isManager(); }
    match /hblSchedule/{id}  { allow read: if whitelisted(); allow write: if isManager(); }
    match /hblAdStatus/{id}  { allow read: if whitelisted(); allow write: if isManager(); }

    // Gmail 改名操作的 durable 紀錄(見 functions/index.js renameUserLogin)：
    // 只有 Cloud Function 用 Admin SDK 寫(Admin SDK 本來就不受這份規則限制)，
    // 客戶端一律不可寫；開放 manager 讀取方便需要時查操作狀態/除錯。
    match /userRenameOperations/{oldEmail} {
      allow read: if isManager();
      allow write: if false;
    }
  }
}
